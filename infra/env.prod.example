# Production environment of Блокум. server-setup.sh copies this file to
# /home/deploy/blokum/shared/.env.prod (mode 600) and fills the generated secrets.
# Never commit the real file. Values in @@…@@ are filled by the setup script.
NODE_ENV=production
TZ=Europe/Moscow
API_HOST=127.0.0.1
API_PORT=3100
WEB_PORT=3110
PUBLIC_URL=https://@@DOMAIN@@
MEDIA_URL=https://@@MEDIA_DOMAIN@@
MEDIA_ROOT=@@DATA_ROOT@@/media
DATA_ROOT=@@DATA_ROOT@@
DATABASE_URL=postgresql://blokum:@@PG_PASSWORD@@@127.0.0.1:5432/blokum_db
REDIS_URL=redis://127.0.0.1:6379/3
SESSION_SECRET=@@SECRET_1@@
IP_HASH_SECRET=@@SECRET_2@@
PRELAUNCH=1
# Phone number of the first administrator, E.164 (task P2.6).
ADMIN_PHONE=
# Вход по телефону выключен решением владельца (ADR-033); в рабочей среде без СМС-провайдера не включать.
PHONE_LOGIN=0
# Ключ шифрования секретов TOTP (AD-01): 64 шестнадцатеричных символа, генерируется скриптом.
TOTP_SECRET_KEY=@@SECRET_3@@
# Providers are chosen by the owner (docs/00-OWNER-DECISIONS.md); empty = feature disabled in production.
SMS_PROVIDER=
SMS_API_KEY=
MAIL_PROVIDER=
MAIL_API_KEY=
MAIL_FROM=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
SMARTCAPTCHA_SERVER_KEY=
SAFE_BROWSING_API_KEY=
TELEGRAM_ALERT_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
ALERT_EMAIL=
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_AGE_RECIPIENT=
# Резервные копии (P9.5): публичный ключ age (age1…) — владелец создаёт пару командой age-keygen и хранит секретную часть у себя.
AGE_RECIPIENT=
BACKUP_DIR=@@DATA_ROOT@@/backups

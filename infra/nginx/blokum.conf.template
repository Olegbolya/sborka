# Блоккер — сгенерировано infra/server-setup.sh из infra/nginx/blokum.conf.template.
# Не правьте на сервере: измените шаблон в репозитории и запустите server-setup.sh снова.
# Здесь только server_name Блоккера; конфигурация BST (mybst.ru) не затрагивается.

upstream blokum_api { server 127.0.0.1:@@API_PORT@@; keepalive 16; }
upstream blokum_web { server 127.0.0.1:@@WEB_PORT@@; keepalive 16; }

limit_req_zone $binary_remote_addr zone=blokum_general:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=blokum_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=blokum_play:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=blokum_upload:10m rate=2r/s;

# ADR-048: IP-адрес — персональные данные, поэтому в журнале доступа он не хранится целиком:
# у IPv4 последний октет заменяется нулём, IPv6 не пишется вовсе. Ограничение запросов выше работает в памяти
# nginx и в журнал не попадает. Журнал ведётся только в серверах Блоккера (журналы BST не затрагиваются).
map $remote_addr $blokum_anon_ip {
    ~^(?<net>\d+\.\d+\.\d+)\.\d+$  $net.0;
    default                                        "-";
}
log_format blokum_anon '$blokum_anon_ip - [$time_local] "$request_method $uri" $status $body_bytes_sent "$http_user_agent" rt=$request_time';

server {
    access_log /var/log/nginx/blokum-access.log blokum_anon;
    listen 80;
    server_name @@DOMAIN@@ www.@@DOMAIN@@ @@MEDIA_DOMAIN@@;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

#@TLS_BEGIN
server {
    access_log /var/log/nginx/blokum-access.log blokum_anon;
    listen 443 ssl http2;
    server_name www.@@DOMAIN@@;
    ssl_certificate     /etc/letsencrypt/live/blokum/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/blokum/privkey.pem;
    return 301 https://@@DOMAIN@@$request_uri;
}

server {
    access_log /var/log/nginx/blokum-access.log blokum_anon;
    listen 443 ssl http2;
    server_name @@DOMAIN@@;

    ssl_certificate     /etc/letsencrypt/live/blokum/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/blokum/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:blokum_ssl:10m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;

    # ASVS V14.3.3: the answers do not name nginx and its version.
    server_tokens off;
    # ASVS V14.5.1: only the methods the site and the API use; others are refused before they reach the application.
    if ($request_method !~ ^(GET|HEAD|POST|PUT|PATCH|DELETE|OPTIONS)$) { return 405; }

    client_max_body_size 25m;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";

#@PRELAUNCH_BEGIN
    # Режим «до запуска»: весь сайт закрыт паролем (снимает только владелец, PRELAUNCH=0).
    auth_basic "Blokum - test mode";
    auth_basic_user_file /etc/nginx/blokum.htpasswd;
#@PRELAUNCH_END

    location = /healthz {
        auth_basic off;
        proxy_pass http://blokum_web;
    }

    location = /api/v1/health {
        auth_basic off;
        proxy_pass http://blokum_api;
    }

    location /api/v1/billing/webhook/ {
        auth_basic off;
        limit_req zone=blokum_general burst=20 nodelay;
        proxy_pass http://blokum_api;
    }

    # Публичное прохождение: ссылки на сборки (/s, /q), страница «выход», памятки участникам, статика сайта и
    # API прохождения открыты без пароля даже в режиме «до запуска» — по ссылке сборку видят все. Кабинет,
    # редактор, вход и всё остальное остаются закрытыми.
    location ^~ /s/ {
        auth_basic off;
        limit_req zone=blokum_general burst=100 nodelay;
        proxy_pass http://blokum_web;
    }

    location ^~ /q/ {
        auth_basic off;
        limit_req zone=blokum_general burst=100 nodelay;
        proxy_pass http://blokum_web;
    }

    location = /out {
        auth_basic off;
        limit_req zone=blokum_general burst=100 nodelay;
        proxy_pass http://blokum_web;
    }

    location ^~ /legal/ {
        auth_basic off;
        limit_req zone=blokum_general burst=100 nodelay;
        proxy_pass http://blokum_web;
    }

    location ^~ /_next/ {
        auth_basic off;
        proxy_pass http://blokum_web;
    }

    location = /icon.svg {
        auth_basic off;
        proxy_pass http://blokum_web;
    }

    location ^~ /api/v1/play/ {
        auth_basic off;
        limit_req zone=blokum_play burst=60 nodelay;
        limit_req_status 429;
        proxy_pass http://blokum_api;
    }

    location /api/v1/auth/ {
        limit_req zone=blokum_auth burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://blokum_api;
    }

    location /api/v1/media {
        limit_req zone=blokum_upload burst=10 nodelay;
        limit_req_status 429;
        client_max_body_size 25m;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_pass http://blokum_api;
    }

    location /api/ {
        limit_req zone=blokum_general burst=60 nodelay;
        limit_req_status 429;
        proxy_pass http://blokum_api;
    }

    location / {
        limit_req zone=blokum_general burst=100 nodelay;
        proxy_pass http://blokum_web;
    }
}

# Пользовательские файлы — отдельное имя, без cookie основного сайта, без исполнения чего-либо.
server {
    access_log /var/log/nginx/blokum-access.log blokum_anon;
    listen 443 ssl http2;
    server_name @@MEDIA_DOMAIN@@;

    ssl_certificate     /etc/letsencrypt/live/@@MEDIA_CERT@@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@@MEDIA_CERT@@/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    server_tokens off;

    root @@DATA_ROOT@@/media;
    autoindex off;
    disable_symlinks on;

    location ~ /\. {
        deny all;
    }

    location / {
        limit_except GET HEAD { deny all; }
        try_files $uri =404;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Content-Security-Policy "default-src 'none'; img-src 'self'; media-src 'self'; font-src 'self'; sandbox" always;
        add_header Cross-Origin-Resource-Policy "cross-origin" always;
        add_header Access-Control-Allow-Origin "https://@@DOMAIN@@" always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }
}
#@TLS_END

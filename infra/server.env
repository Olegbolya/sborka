# Non-secret server settings of Блоккер (read by server-setup.sh and deploy.sh). Secrets live only
# in /home/deploy/blokum/shared/.env.prod on the server.
SERVER_IP=95.105.7.135
DEPLOY_USER=deploy
DOMAIN=blokker.ru
# Separate registrable domain is recommended for user files (docs/00-OWNER-DECISIONS.md, решение 5).
# Until it is bought, a subdomain of the main domain is used.
MEDIA_DOMAIN=media.blokker.ru
# Optional e-mail for Let's Encrypt expiry notices (the server's existing certbot account is reused).
CERTBOT_EMAIL=
# 1 = the whole site is behind HTTP basic auth (pre-launch mode, docs/02-ARCHITECTURE.md §3.1).
# 0 since 10.11.2026: the owner decided to take the password off (PROGRESS, «Вопросы владельцу»). nginx changes when the owner
# runs server-setup.sh once more.
PRELAUNCH=${PRELAUNCH:-0}
NODE_MAJOR=22
PNPM_VERSION=10.34.7
API_PORT=3100
WEB_PORT=3110
REDIS_DB=3
# User files and exports live outside /home so nginx (www-data) can read media without opening the home folder.
DATA_ROOT=/srv/blokum
# ЮKassa: номер магазина (не секрет). Сейчас — тестовый магазин; при переходе на боевой магазин здесь меняется номер, а секретный ключ
# заменяется в GitHub Secrets (YOOKASSA_SECRET_KEY). Если секретного ключа нет, оплата на сайте отвечает «не подключена».
YOOKASSA_SHOP_ID=1524621
# Вход через Яндекс ID (A-01): ID приложения с oauth.yandex.ru — не секрет (вход по коду с PKCE, секретный ключ не нужен).
YANDEX_CLIENT_ID=1323492b22bb44219844fa0beb6ca318
# Вход через VK ID (A-01): ID приложения с id.vk.com — не секрет (вход по коду с PKCE).
VK_CLIENT_ID=54888388

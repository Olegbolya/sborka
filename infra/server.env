# Non-secret server settings of Блокум (read by server-setup.sh and deploy.sh). Secrets live only
# in /home/deploy/blokum/shared/.env.prod on the server.
SERVER_IP=95.105.7.135
DEPLOY_USER=deploy
DOMAIN=blokum.ru
# Separate registrable domain is recommended for user files (docs/00-OWNER-DECISIONS.md, решение 5).
# Until it is bought, a subdomain of the main domain is used.
MEDIA_DOMAIN=media.blokum.ru
# Optional e-mail for Let's Encrypt expiry notices (the server's existing certbot account is reused).
CERTBOT_EMAIL=
# 1 = the whole site is behind HTTP basic auth (pre-launch mode, docs/02-ARCHITECTURE.md §3.1).
PRELAUNCH=${PRELAUNCH:-1}
NODE_MAJOR=22
PNPM_VERSION=10.34.7
API_PORT=3100
WEB_PORT=3110
REDIS_DB=3
# User files and exports live outside /home so nginx (www-data) can read media without opening the home folder.
DATA_ROOT=/srv/blokum

{
  "name": "blokum",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Блокум — конструктор интерактивных сборок",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel --filter=@blokum/web --filter=@blokum/api --filter=@blokum/worker",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "playwright test",
    "verify": "node scripts/verify.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "db:migrate": "pnpm --filter @blokum/db build && pnpm --filter @blokum/db db:migrate",
    "db:seed": "pnpm --filter @blokum/db build && pnpm --filter @blokum/db db:seed",
    "db:generate": "pnpm --filter @blokum/db db:generate",
    "services": "bash scripts/dev-services.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@blokum/config": "workspace:*",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "turbo": "2.11.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}

{
  "name": "@blokum/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Сайт, кабинет, редактор, плеер и админка Блокума (Next.js)",
  "scripts": {
    "build": "node scripts/copy-vendor.mjs && next build",
    "dev": "node scripts/copy-vendor.mjs && next dev --port 3110",
    "start": "next start --port 3110",
    "typecheck": "next typegen && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@blokum/engine": "workspace:*",
    "@blokum/observability": "workspace:*",
    "@blokum/renderer": "workspace:*",
    "@blokum/schema": "workspace:*",
    "@blokum/ui": "workspace:*",
    "@tiptap/core": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "immer": "^11.2.9",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@blokum/config": "workspace:*",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}

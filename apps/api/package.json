{
  "name": "@blokum/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "API Блокума (NestJS)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node ../../scripts/dev-node.mjs dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@blokum/db": "workspace:*",
    "@blokum/observability": "workspace:*",
    "@blokum/schema": "workspace:*",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "bullmq": "^6.4.0",
    "drizzle-orm": "0.45.4",
    "exceljs": "^4.4.0",
    "file-type": "^22.2.0",
    "ioredis": "5.11.1",
    "multer": "^2.0.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@blokum/config": "workspace:*",
    "@nestjs/testing": "12.2.0",
    "@swc/core": "1.16.18",
    "@types/express": "5.0.6",
    "@types/multer": "^1.4.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "pg": "8.23.1",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}

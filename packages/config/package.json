{
  "name": "@blokum/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Общие настройки TypeScript, ESLint и Vitest",
  "exports": {
    "./tsconfig/*.json": "./tsconfig/*.json",
    "./eslint": {
      "types": "./eslint/index.d.ts",
      "default": "./eslint/index.js"
    },
    "./vitest": {
      "types": "./vitest/index.d.ts",
      "default": "./vitest/index.js"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript-eslint": "8.72.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "vitest": "5.0.5"
  }
}
